{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liapoldus/pluginprotocol/contracts/forms-db/v1/admin-surface-response.schema.json",
  "title": "Ответ поверхности администратора forms-db v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "plugin", "requiredCapabilities"],
  "properties": {
    "version": { "const": 1 },
    "plugin": { "type": "string", "minLength": 1 },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
