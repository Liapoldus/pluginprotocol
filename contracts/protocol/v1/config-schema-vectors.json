{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liapoldus/pluginprotocol/contracts/protocol/v1/config-schema-vectors.json",
  "protocolVersion": "liapoldus.plugin.v1",
  "positive": [
    {
      "id": "nested-object-array-enum-local-ref",
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "listeners": {
            "type": "array",
            "items": { "$ref": "#/$defs/listener" }
          }
        },
        "required": ["listeners"],
        "additionalProperties": false,
        "$defs": {
          "listener": {
            "type": "object",
            "properties": {
              "protocol": { "enum": ["http", "https"] },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "required": ["protocol", "port"],
            "additionalProperties": false
          }
        }
      },
      "result": "accepted"
    },
    {
      "id": "empty-schema-for-plugin-with-no-application-settings",
      "jsonSchema": "",
      "pluginAcceptsApplicationSettings": false,
      "result": "accepted"
    }
  ],
  "negative": [
    { "id": "invalid-json", "jsonSchema": "{", "result": "INVALID_ARGUMENT" },
    {
      "id": "unsupported-dialect",
      "jsonSchema": { "$schema": "https://json-schema.org/draft/2019-09/schema", "type": "object" },
      "result": "INVALID_ARGUMENT"
    },
    {
      "id": "remote-reference",
      "jsonSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "$ref": "https://example.invalid/schema.json" },
      "result": "INVALID_ARGUMENT"
    },
    {
      "id": "schema-over-limit",
      "encodedBytes": 262145,
      "maxBytes": 262144,
      "result": "RESOURCE_EXHAUSTED"
    },
    {
      "id": "missing-schema-for-settings",
      "jsonSchema": "",
      "pluginAcceptsApplicationSettings": true,
      "result": "NOT_SERVING"
    }
  ]
}
