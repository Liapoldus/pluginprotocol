{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liapoldus/pluginprotocol/blob/main/contracts/protocol/v1/stream-open-context.schema.json",
  "title": "Plugin Stream open context",
  "description": "Versioned, bounded request/connection metadata only. Streaming body bytes use typed Stream messages, never this JSON context. Socket handles, filesystem paths, credentials and arbitrary secret values are forbidden. Explicitly allow-listed cookie values may be included and are always sensitive/redacted.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "destination"],
      "properties": {
        "kind": { "const": "tcp" },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sni": { "type": "string", "maxLength": 253 },
        "alpn": { "type": "string", "maxLength": 255 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "destination"],
      "properties": {
        "kind": { "const": "udp" },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "method", "path", "requestId"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "http" },
        "method": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,32}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "query": { "type": "string", "maxLength": 8192 },
        "headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$" },
          "additionalProperties": { "type": "string", "maxLength": 8192 }
        },
        "cookies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "value": { "type": "string", "maxLength": 4096 }
            }
          }
        },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "remoteAddr": { "type": "string", "maxLength": 256 },
        "context": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 4096 } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "method", "path", "requestId", "offeredSubprotocols"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "websocket" },
        "method": { "type": "string", "const": "GET" },
        "path": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "query": { "type": "string", "maxLength": 8192 },
        "headers": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 8192 } },
        "cookies": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 256 }, "value": { "type": "string", "maxLength": 4096 } } } },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "remoteAddr": { "type": "string", "maxLength": 256 },
        "offeredSubprotocols": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "method", "path", "requestId"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "sse" },
        "method": { "type": "string", "const": "GET" },
        "path": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "query": { "type": "string", "maxLength": 8192 },
        "headers": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 8192 } },
        "cookies": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 256 }, "value": { "type": "string", "maxLength": 4096 } } } },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "remoteAddr": { "type": "string", "maxLength": 256 }
      }
    }
  ]
}
