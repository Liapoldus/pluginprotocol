{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liapoldus/pluginprotocol/contracts/protocol/v1/local-bootstrap.schema.json",
  "title": "Local supervised workload bootstrap v1",
  "description": "One-shot public identity exchange over the private inherited gateway-to-plugin and plugin-to-gateway pipes. It never carries private keys, settings, grants, or application secrets.",
  "oneOf": [
    { "$ref": "#/$defs/gatewayOffer" },
    { "$ref": "#/$defs/pluginResponse" },
    { "$ref": "#/$defs/gatewayConfirmation" }
  ],
  "$defs": {
    "identity": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 512 },
    "certificate": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 12000 },
    "challenge": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
    "gatewayOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "gatewayIdentity", "pluginIdentity", "gatewayChallenge", "gatewayCertificate"],
      "properties": {
        "protocolVersion": { "const": "liapoldus.plugin.v1" },
        "gatewayIdentity": { "$ref": "#/$defs/identity" },
        "pluginIdentity": { "$ref": "#/$defs/identity" },
        "gatewayChallenge": { "$ref": "#/$defs/challenge" },
        "gatewayCertificate": { "$ref": "#/$defs/certificate" }
      }
    },
    "pluginResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "gatewayIdentity", "pluginIdentity", "gatewayChallenge", "pluginChallenge", "pluginCertificate"],
      "properties": {
        "protocolVersion": { "const": "liapoldus.plugin.v1" },
        "gatewayIdentity": { "$ref": "#/$defs/identity" },
        "pluginIdentity": { "$ref": "#/$defs/identity" },
        "gatewayChallenge": { "$ref": "#/$defs/challenge" },
        "pluginChallenge": { "$ref": "#/$defs/challenge" },
        "pluginCertificate": { "$ref": "#/$defs/certificate" }
      }
    },
    "gatewayConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "gatewayIdentity", "pluginIdentity", "gatewayChallenge", "pluginChallenge"],
      "properties": {
        "protocolVersion": { "const": "liapoldus.plugin.v1" },
        "gatewayIdentity": { "$ref": "#/$defs/identity" },
        "pluginIdentity": { "$ref": "#/$defs/identity" },
        "gatewayChallenge": { "$ref": "#/$defs/challenge" },
        "pluginChallenge": { "$ref": "#/$defs/challenge" }
      }
    }
  }
}
