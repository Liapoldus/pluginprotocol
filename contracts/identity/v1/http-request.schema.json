{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liapoldus/pluginprotocol/contracts/identity/v1/http-request.schema.json",
  "title": "HTTP-запрос identity capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "path", "requestId"],
  "properties": {
    "method": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,32}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "query": { "type": "string", "maxLength": 8192 },
    "headers": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$" },
      "additionalProperties": { "type": "string", "maxLength": 8192 }
    },
    "cookies": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "../../http/v1/cookie-pair.schema.json#/$defs/cookiePair" }
    },
    "body": { "type": "string", "contentEncoding": "base64" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "remoteAddr": { "type": "string", "maxLength": 256 },
    "context": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    }
  }
}
